    weee:hasScopeContext <http://weee-kg.org/context/scope/76330bfb8bbe7b51008dc179> ;
    rel:memberOfMethodFamily <http://weee-kg.org/anchor:MethodFamily:bioleaching> .

<http://weee-kg.org/source:A%20Copper-Catalyzed%20Bioleaching%20Process%20for%20Enhancement%20of%20Cobalt%20Dissolution%20from%20Spent%20Lithium-Ion%20Batteries:Process_A__ferrooxidans_bioleaching_without_copper_ion__control_> a weee:Process ;
    rdfs:label "A. ferrooxidans bioleaching without copper ion (control)" ;
    weee:description "A. ferrooxidans bioleaching without copper ion (control) is a source-specific Process entity in the study A Copper-Catalyzed Bioleaching Process for Enhancement of Cobalt Dissolution from Spent Lithium-Ion Batteries. Scope: Controlled bioleaching of LiCoO2 with Acidithiobacillus ferrooxidans in 9K medium at 1% pulp density, 5% (v/v) inoculum, pH 2.0, 35°C, 160 rpm for 10 days without added copper ion; Co concentration determined over 10 days. Quantitative observations concern: Co." ;
    weee:hasScopeContext <http://weee-kg.org/context/scope/57b6de3e0513a9a7ad946c5c> ;
    rel:hasResultObservation <http://weee-kg.org/source:A%20Copper-Catalyzed%20Bioleaching%20Process%20for%20Enhancement%20of%20Cobalt%20Dissolution%20from%20Spent%20Lithium-Ion%20Batteries:Observation_REL_Process_A__ferrooxidans_bioleaching_without_copper_ion__control__HAS_OUTPUT_Material_Co_e7f9f2bcaec630fa> ;
    rel:memberOfMethodFamily <http://weee-kg.org/anchor:MethodFamily:bioleaching> .

<http://weee-kg.org/source:Bioleaching%20of%20Valuable%20Metals%20from%20Spent%20Lithium-Ion%20Mobile%20Phone%20Batteries%20Using%20Aspergillus%20Niger:Process_control_bioleaching> a weee:Process ;
    rdfs:label "control bioleaching" ;
    weee:description "control bioleaching is a source-specific Process entity in the study Bioleaching of Valuable Metals from Spent Lithium-Ion Mobile Phone Batteries Using Aspergillus Niger. Scope: A control experiment was performed in parallel using fresh sucrose medium (pH 6) with 1% (w/v) sterilized battery powder but without inoculation, incubated at 30 °C and 130 rpm. Quantitative observations concern: Cu, Li." ;
    weee:hasScopeContext <http://weee-kg.org/context/scope/47ab2162d98d52c0a9abd5ec> ;
    rel:hasResultObservation <http://weee-kg.org/source:Bioleaching%20of%20Valuable%20Metals%20from%20Spent%20Lithium-Ion%20Mobile%20Phone%20Batteries%20Using%20Aspergillus%20Niger:Observation_REL_Process_control_bioleaching_HAS_OUTPUT_Material_Cu_b63253ea11bcbad3>,
        <http://weee-kg.org/source:Bioleaching%20of%20Valuable%20Metals%20from%20Spent%20Lithium-Ion%20Mobile%20Phone%20Batteries%20Using%20Aspergillus%20Niger:Observation_REL_Process_control_bioleaching_HAS_OUTPUT_Material_Li_d4dd0cc310afb4e6> ;
    rel:memberOfMethodFamily <http://weee-kg.org/anchor:MethodFamily:bioleaching> .

<http://weee-kg.org/source:Bioleaching%20of%20Valuable%20Metals%20from%20Spent%20Lithium-Ion%20Mobile%20Phone%20Batteries%20Using%20Aspergillus%20Niger:Process_two_step_bioleaching> a weee:Process ;
    rdfs:label "two-step bioleaching" ;
    weee:description "two-step bioleaching is a source-specific Process entity in the study Bioleaching of Valuable Metals from Spent Lithium-Ion Mobile Phone Batteries Using Aspergillus Niger. Scope: niger was pre-cultured in 100 mL sucrose medium (pH 6) at 30 °C and 130 rpm; after 3 days when the fungus entered logarithmic phase, 1% (w/v) sterilized battery powder was added and bioleaching continued for 27 days under the same conditions. Quantitative observations concern: Al, Co, Cu, Li, Mn." ;
    weee:hasScopeContext <http://weee-kg.org/context/scope/b37104eaaf7d47550a64fff1> ;
    rel:hasResultObservation <http://weee-kg.org/source:Bioleaching%20of%20Valuable%20Metals%20from%20Spent%20Lithium-Ion%20Mobile%20Phone%20Batteries%20Using%20Aspergillus%20Niger:Observation_REL_Process_two_step_bioleaching_HAS_OUTPUT_Material_Al_3bd024274ea17f6c>,
