<http://weee-kg.org/context/scope/8c2d0c80f8a96e8d62139f5d> a weee:ScopeContext ;
    weee:bindingStatus "bound" ;
    weee:description "Cathode and anode films from waste mobile phone LIBs were treated with Citrus pseudolimon (galgal) juice in a 250 mL round-bottom flask at a film-to-juice w/v ratio of 50,000 mg/L, 90 °C for 20 min for binder removal; after separating Cu and Al films, the remaining solution was refluxed for 30 min and filtered to remove carbon and impurities, and the filtrate was analyzed for leaching rate by ICP-MS relative to tri-acid digestion." ;
    weee:evidenceRef "scope:scope-assertion:b2d74ef10f3f4bc3:evidence",
        "source:Green and Facile Method for the Recovery of Spent Lithium Nickel Manganese Cobalt Oxide (NMC) Based Lithium Ion Batteries:Process_metal_leaching_from_cathode_and_anode_film_using_citrus_pseudolimon_juice:entity" ;
    weee:evidenceSpan "Cathode and anode films from waste mobile phone LIBs were treated with Citrus pseudolimon (galgal) juice in a 250 mL round-bottom flask at a film-to-juice w/v ratio of 50,000 mg/L, 90 °C for 20 min for binder removal; after separating Cu and Al films, the remaining solution was refluxed for 30 min and filtered to remove carbon and impurities, and the filtrate was analyzed for leaching rate by ICP-MS relative to tri-acid digestion." ;
    weee:methodFamily "metal leaching" ;
    weee:micrographId "Green and Facile Method for the Recovery of Spent Lithium Nickel Manganese Cobalt Oxide (NMC) Based Lithium Ion Batteries" ;
    weee:scopeDescription "Cathode and anode films from waste mobile phone LIBs were treated with Citrus pseudolimon (galgal) juice in a 250 mL round-bottom flask at a film-to-juice w/v ratio of 50,000 mg/L, 90 °C for 20 min for binder removal; after separating Cu and Al films, the remaining solution was refluxed for 30 min and filtered to remove carbon and impurities, and the filtrate was analyzed for leaching rate by ICP-MS relative to tri-acid digestion." ;
    weee:scopeFacetsJson "{\"method_family\": \"metal leaching\"}" ;
    weee:scopeId "scope-assertion:b2d74ef10f3f4bc3" ;
    weee:scopeKind "process_method_family" ;
