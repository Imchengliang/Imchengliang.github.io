<http://weee-kg.org/context/scope/c64d18a2b06ba90d04fac347> a weee:ScopeContext ;
    weee:bindingStatus "bound" ;
    weee:description "Grinding flotation experiments were carried out in standard Hardgrove apparatus and lab-scale flotation machine. First, 40 g of mixed electrode powder together with steel balls were sealed in the grinding chamber. The grinding times were 2.5 min, 5 min, 10 min, 20 min and 30 min, respectively. Then, the grinding productions were subjected to reverse flotation with the same experimental conditions." ;
    weee:evidenceRef "scope:scope-assertion:39985a7f1983d33f:evidence",
        "source:A_Promising_Physical_Method_for_Recovery_of_Licoo_2_and_Graphite_from_Spent_Lithium-Ion_Batteries_Grinding_Flotation:Process_grinding_flotation:entity" ;
    weee:evidenceSpan "Grinding flotation experiments were carried out in standard Hardgrove apparatus and lab-scale flotation machine. First, 40 g of mixed electrode powder together with steel balls were sealed in the grinding chamber. The grinding times were 2.5 min, 5 min, 10 min, 20 min and 30 min, respectively. Then, the grinding productions were subjected to reverse flotation with the same experimental conditions." ;
    weee:methodFamily "grinding flotation" ;
    weee:micrographId "A_Promising_Physical_Method_for_Recovery_of_Licoo_2_and_Graphite_from_Spent_Lithium-Ion_Batteries_Grinding_Flotation" ;
    weee:scopeDescription "Grinding flotation experiments were carried out in standard Hardgrove apparatus and lab-scale flotation machine. First, 40 g of mixed electrode powder together with steel balls were sealed in the grinding chamber. The grinding times were 2.5 min, 5 min, 10 min, 20 min and 30 min, respectively. Then, the grinding productions were subjected to reverse flotation with the same experimental conditions." ;
    weee:scopeFacetsJson "{\"method_family\": \"grinding flotation\"}" ;
    weee:scopeId "scope-assertion:39985a7f1983d33f" ;
    weee:scopeKind "process_method_family" ;
    weee:sourcePaper "A Promising Physical Method for Recovery of Licoo 2 and Graphite from Spent Lithium-Ion Batteries Grinding Flotation" .

