<http://weee-kg.org/context/scope/82531d6b0ac5836fcdae49b5> a weee:ScopeContext ;
    weee:bindingStatus "bound" ;
    weee:description "Powder prepared from manually crushed and ball-milled cathodes and anodes of the collected spent Li-ion batteries, sieved to <75 µm and autoclaved before use." ;
    weee:evidenceRef "scope:scope-assertion:3888a644b8a68a40:evidence",
        "source:Bioleaching_of_Valuable_Metals_from_Spent_Lithium-Ion_Mobile_Phone_Batteries_Using_Aspergillus_Niger:Component_powder:entity" ;
    weee:evidenceSpan "Cathodes and anodes were manually crushed into small particles with a pair of scissors and then ground by a ball mill (Fritsch, Germany) until transmuted to fine powder. The powder was sieved by vibrator shifter with mesh# 200 to get homogeneous mixture. All battery powders used in this research were of a particle size less than 75 mm. The final mixture was used for all subsequent experiments, yet prior to use, it was autoclaved at 121 ^∘C for 15 min." ;
    weee:micrographId "Bioleaching_of_Valuable_Metals_from_Spent_Lithium-Ion_Mobile_Phone_Batteries_Using_Aspergillus_Niger" ;
    weee:populationGranularity "batch" ;
    weee:sampleType "battery powder" ;
    weee:scopeDescription "Powder prepared from manually crushed and ball-milled cathodes and anodes of the collected spent Li-ion batteries, sieved to <75 µm and autoclaved before use." ;
    weee:scopeFacetsJson "{\"population_granularity\": \"batch\", \"sample_type\": \"battery powder\"}" ;
    weee:scopeId "scope-assertion:3888a644b8a68a40" ;
    weee:scopeKind "declared_population" ;
    weee:sourcePaper "Bioleaching of Valuable Metals from Spent Lithium-Ion Mobile Phone Batteries Using Aspergillus Niger" .

