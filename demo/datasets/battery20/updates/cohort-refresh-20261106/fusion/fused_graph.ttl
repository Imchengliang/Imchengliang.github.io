<http://weee-kg.org/context/scope/7b9dc3736c7ebb2d68eb3e47> a weee:ScopeContext ;
    weee:bindingStatus "bound" ;
    weee:description "Cathode materials separated from donated spent LIBs using NMP, then calcined at 700 °C for 5 h to remove carbon and PVDF before leaching." ;
    weee:evidenceRef "scope:scope-assertion:e9444b2f75b7a4f3:evidence",
        "source:Ultrasound-Assisted Leaching of Cobalt and Lithium from Spent Lithium-Ion Batteries:Component_cathode:entity" ;
    weee:evidenceSpan "cathodes obtained after discharging and physical separation were treated with NMP at 100 ^∘C for 1h. The cathode materials were effectively separated from the aluminum foil and then calcined at 700 ^∘C for 5 h in a muffle oven to eliminate the carbon and the polyvinylidene fluoride (PVDF)." ;
    weee:micrographId "Ultrasound-Assisted Leaching of Cobalt and Lithium from Spent Lithium-Ion Batteries" ;
    weee:populationGranularity "batch" ;
    weee:sampleType "cathode active material from spent lithium-ion batteries" ;
