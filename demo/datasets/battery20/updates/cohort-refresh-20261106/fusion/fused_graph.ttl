    rel:memberOfMethodFamily <http://weee-kg.org/anchor:MethodFamily:batch_leaching_test> .

<http://weee-kg.org/source:Heat%20Treatment%20of%20Licoo2%20Recovered%20from%20Cathode%20Scraps%20with%20Solvent%20Method:Process_electrochemical_cycling_of_recovered_scrap_material_electrodes> a weee:Process ;
    rdfs:label "electrochemical cycling of recovered scrap material electrodes" ;
    weee:description "electrochemical cycling of recovered scrap material electrodes is a source-specific Process entity in the study Heat Treatment of Licoo2 Recovered from Cathode Scraps with Solvent Method. Scope: The cells were charged and discharged between 3.0 V and 4.3 V versus Li ^+ / Li by applying a current density of 30 mA g ^-1 at 25 ^∘𝖢." ;
    weee:hasScopeContext <http://weee-kg.org/context/scope/0d6cadff32fafce28befdae3> ;
