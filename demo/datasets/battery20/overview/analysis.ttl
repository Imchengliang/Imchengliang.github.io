<urn:ontoweee:analysis:profile:smartphones%2Fafter> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_battery" ;
    analysis:case_id "smartphones" ;
    analysis:chemistry "chemistry-unspecified" ;
    analysis:chemistry_resolved false ;
    analysis:evidenceSpan "EoL smartphones were directly collected from users, through announcements on social media. To improve representativeness, a well distribution of manufacturing years, variety of brands, and devices in good conditions were prioritized: devices from nine different brands were collected, and no model was repeated." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "smartphones/after" ;
    analysis:label "Phone batteries manufactured after 2015" ;
    analysis:material_class "whole-cell" ;
    analysis:node_id "http://weee-kg.org/source:Assessment%20of%20Smartphones%E2%80%99%20Components%20and%20Materials%20for%20a%20Recycling%20Perspective-%20Tendencies%20of%20Composition%20and%20Target%20Elements:Component_battery" ;
    analysis:note "Table 3 distributes each element among phone components. Those shares are excluded from battery concentration summaries." ;
    analysis:origin "end-of-life-phones" ;
    analysis:paper "Assessment of Smartphones’ Components and Materials for a Recycling Perspective- Tendencies of Composition and Target Elements" ;
    analysis:payload "{\"id\": \"smartphones/after\", \"label\": \"Phone batteries manufactured after 2015\", \"chemistry\": \"chemistry-unspecified\", \"stream\": \"whole\", \"origin\": \"end-of-life-phones\", \"state\": \"Separated batteries, after-2015 cohort\", \"entity_ids\": [\"Component_battery\"], \"method_family\": null, \"note\": \"Table 3 distributes each element among phone components. Those shares are excluded from battery concentration summaries.\", \"evidence\": [\"EoL smartphones were directly collected from users, through announcements on social media. To improve representativeness, a well distribution of manufacturing years, variety of brands, and devices in good conditions were prioritized: devices from nine different brands were collected, and no model was repeated.\"], \"material_class\": \"whole-cell\", \"preparation\": [\"dismantled\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": false, \"classification_evidence\": [\"EoL smartphones were directly collected from users, through announcements on social media. To improve representativeness, a well distribution of manufacturing years, variety of brands, and devices in good conditions were prioritized: devices from nine different brands were collected, and no model was repeated.\", \"The parameters for acidic digestions were: 20 mL of solution per gram of solids, at 80 ^∘C, under agitation speed of 300 rpm, for 2 h. Reactors (schlenk flasks) coupled with allihn condensers were used to avoid solvent losses. After the established time, samples were filtrated and diluted in volumetric flasks, and the liquors analyzed by ICP-OES.\"], \"case_id\": \"smartphones\", \"paper\": \"Assessment of Smartphones’ Components and Materials for a Recycling Perspective- Tendencies of Composition and Target Elements\", \"node_id\": \"http://weee-kg.org/source:Assessment%20of%20Smartphones%E2%80%99%20Components%20and%20Materials%20for%20a%20Recycling%20Perspective-%20Tendencies%20of%20Composition%20and%20Target%20Elements:Component_battery\"}" ;
    analysis:state "Separated batteries, after-2015 cohort" ;
    analysis:stream "whole" .

<urn:ontoweee:analysis:profile:source-9f8e67169119c4a8%2Ffraction-7> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_1_3_mm__Li_ion_" ;
    analysis:case_id "source-9f8e67169119c4a8" ;
    analysis:chemistry "li-ion-unspecified" ;
    analysis:chemistry_resolved false ;
    analysis:evidenceSpan "Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).",
        "In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-9f8e67169119c4a8/fraction-7" ;
    analysis:label "Li-ion fraction 1–3 mm" ;
    analysis:material_class "mixed-electrode-material" ;
    analysis:node_id "http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_1_3_mm__Li_ion_" ;
    analysis:note "Table 3 reports leachate release in mg/kg and is excluded from feedstock composition." ;
    analysis:origin "collection-boxes" ;
    analysis:paper "Chemical Characterisation of Spent Rechargeable Batteries" ;
    analysis:payload "{\"id\": \"source-9f8e67169119c4a8/fraction-7\", \"label\": \"Li-ion fraction 1–3 mm\", \"chemistry\": \"li-ion-unspecified\", \"stream\": \"separated-fractions\", \"origin\": \"collection-boxes\", \"state\": \"Milled, fractionated and dried to constant mass at 105 °C\", \"entity_ids\": [\"Component_1_3_mm__Li_ion_\"], \"method_family\": null, \"note\": \"Table 3 reports leachate release in mg/kg and is excluded from feedstock composition.\", \"evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\"], \"material_class\": \"mixed-electrode-material\", \"preparation\": [\"milled\", \"screened\", \"oven-dried\"], \"size_fraction_mm\": [1, 3], \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": false, \"classification_evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\", \"All metals except mercury were measured by ICP/AES; mercury was analysed by cold vapour atomic absorption spectrometry (CVAAS).\", \"Weight loss, mainly due to the vaporisation of moisture and other volatile compounds, was determined by drying the samples to a constant mass at 105 \\u0003C (about 3–4 h were needed). All data reported refer to dry weight.\"], \"case_id\": \"source-9f8e67169119c4a8\", \"paper\": \"Chemical Characterisation of Spent Rechargeable Batteries\", \"node_id\": \"http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_1_3_mm__Li_ion_\"}" ;
    analysis:state "Milled, fractionated and dried to constant mass at 105 °C" ;
    analysis:stream "separated-fractions" .

