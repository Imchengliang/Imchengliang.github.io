<urn:ontoweee:analysis:profile:source-98d7e11c7ecce524%2Felectrodes> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_electrode" ;
    analysis:case_id "source-98d7e11c7ecce524" ;
    analysis:chemistry "lco" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "This work proposes a new process of recovering Co from spent Li-ion batteries (LIBs) by a combination of crushing, ultrasonic washing, acid leaching and precipitation, in which ultrasonic washing was used for the first time as an alternative process to improve the recovery efficiency of Co and reduce energy consumption and pollution. Spent LIBs were crushed with a 12 mm aperture screen, and the undersize products were put into an ultrasonic washing container to separate electrode materials from their support substrate. The washed materials were filtered through a 2 mm aperture screen to get underflow products, namely recovered electrodes. Ninety two percent of the Co was transferred to the recovered electrodes where Co accounted for 28% of the mass and impurities, including Al, Fe, and Cu, accounted for 2%. The valuable materials left in 2–12 mm products, including Cu, Al, and Fe, were presented as thin sheets, and could be easily separated. The recovered electrodes were leached with 4.0 M HCl for 2.0 h, at 80 ^∘C, along with concurrent agitation. Ninety seven percent of the Li and 99% of the Co in recovered electrodes could be dissolved. The impurities could be removed at pH 4.5–6.0 with little loss of Co by chemical precipitation. This process is feasible for recycling spent LIBs in scale-up." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-98d7e11c7ecce524/electrodes" ;
    analysis:label "Recovered mixed electrode fraction" ;
    analysis:material_class "mixed-electrode-material" ;
    analysis:method_family "Acid leaching" ;
    analysis:node_id "http://weee-kg.org/source:A%20Combined%20Recovery%20Process%20of%20Metals%20in%20Spent%20Lithium-Ion%20Batteries:Component_electrode" ;
    analysis:note "The reported 2% impurity total is excluded from individual Al, Fe and Cu contents." ;
    analysis:origin "recycling-company" ;
    analysis:paper "A Combined Recovery Process of Metals in Spent Lithium-Ion Batteries" ;
    analysis:payload "{\"id\": \"source-98d7e11c7ecce524/electrodes\", \"label\": \"Recovered mixed electrode fraction\", \"chemistry\": \"lco\", \"stream\": \"mixed-electrodes\", \"origin\": \"recycling-company\", \"state\": \"Crushed, ultrasonically washed and screened\", \"entity_ids\": [\"Component_electrode\"], \"method_family\": \"Acid leaching\", \"note\": \"The reported 2% impurity total is excluded from individual Al, Fe and Cu contents.\", \"evidence\": [\"This work proposes a new process of recovering Co from spent Li-ion batteries (LIBs) by a combination of crushing, ultrasonic washing, acid leaching and precipitation, in which ultrasonic washing was used for the first time as an alternative process to improve the recovery efficiency of Co and reduce energy consumption and pollution. Spent LIBs were crushed with a 12 mm aperture screen, and the undersize products were put into an ultrasonic washing container to separate electrode materials from their support substrate. The washed materials were filtered through a 2 mm aperture screen to get underflow products, namely recovered electrodes. Ninety two percent of the Co was transferred to the recovered electrodes where Co accounted for 28% of the mass and impurities, including Al, Fe, and Cu, accounted for 2%. The valuable materials left in 2–12 mm products, including Cu, Al, and Fe, were presented as thin sheets, and could be easily separated. The recovered electrodes were leached with 4.0 M HCl for 2.0 h, at 80 ^∘C, along with concurrent agitation. Ninety seven percent of the Li and 99% of the Co in recovered electrodes could be dissolved. The impurities could be removed at pH 4.5–6.0 with little loss of Co by chemical precipitation. This process is feasible for recycling spent LIBs in scale-up.\"], \"material_class\": \"mixed-electrode-material\", \"preparation\": [\"crushed\", \"ultrasonically-washed\", \"screened\"], \"size_fraction_mm\": [null, 2], \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"This work proposes a new process of recovering Co from spent Li-ion batteries (LIBs) by a combination of crushing, ultrasonic washing, acid leaching and precipitation, in which ultrasonic washing was used for the first time as an alternative process to improve the recovery efficiency of Co and reduce energy consumption and pollution. Spent LIBs were crushed with a 12 mm aperture screen, and the undersize products were put into an ultrasonic washing container to separate electrode materials from their support substrate. The washed materials were filtered through a 2 mm aperture screen to get underflow products, namely recovered electrodes. Ninety two percent of the Co was transferred to the recovered electrodes where Co accounted for 28% of the mass and impurities, including Al, Fe, and Cu, accounted for 2%. The valuable materials left in 2–12 mm products, including Cu, Al, and Fe, were presented as thin sheets, and could be easily separated. The recovered electrodes were leached with 4.0 M HCl for 2.0 h, at 80 ^∘C, along with concurrent agitation. Ninety seven percent of the Li and 99% of the Co in recovered electrodes could be dissolved. The impurities could be removed at pH 4.5–6.0 with little loss of Co by chemical precipitation. This process is feasible for recycling spent LIBs in scale-up.\"], \"case_id\": \"source-98d7e11c7ecce524\", \"paper\": \"A Combined Recovery Process of Metals in Spent Lithium-Ion Batteries\", \"node_id\": \"http://weee-kg.org/source:A%20Combined%20Recovery%20Process%20of%20Metals%20in%20Spent%20Lithium-Ion%20Batteries:Component_electrode\"}" ;
    analysis:state "Crushed, ultrasonically washed and screened" ;
    analysis:stream "mixed-electrodes" .

<urn:ontoweee:analysis:profile:source-9f8e67169119c4a8%2Ffraction-1> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_Iron__Ni_Cd_" ;
    analysis:case_id "source-9f8e67169119c4a8" ;
    analysis:chemistry "ni-cd" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).",
        "In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-9f8e67169119c4a8/fraction-1" ;
    analysis:label "Ni-Cd ferrous fraction" ;
    analysis:material_class "ferrous-fraction" ;
    analysis:node_id "http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_Iron__Ni_Cd_" ;
    analysis:note "Table 3 reports leachate release in mg/kg and is excluded from feedstock composition." ;
    analysis:origin "collection-boxes" ;
    analysis:paper "Chemical Characterisation of Spent Rechargeable Batteries" ;
    analysis:payload "{\"id\": \"source-9f8e67169119c4a8/fraction-1\", \"label\": \"Ni-Cd ferrous fraction\", \"chemistry\": \"ni-cd\", \"stream\": \"separated-fractions\", \"origin\": \"collection-boxes\", \"state\": \"Milled, fractionated and dried to constant mass at 105 °C\", \"entity_ids\": [\"Component_Iron__Ni_Cd_\"], \"method_family\": null, \"note\": \"Table 3 reports leachate release in mg/kg and is excluded from feedstock composition.\", \"evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\"], \"material_class\": \"ferrous-fraction\", \"preparation\": [\"milled\", \"magnetically-separated\", \"oven-dried\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\", \"All metals except mercury were measured by ICP/AES; mercury was analysed by cold vapour atomic absorption spectrometry (CVAAS).\", \"Weight loss, mainly due to the vaporisation of moisture and other volatile compounds, was determined by drying the samples to a constant mass at 105 \\u0003C (about 3–4 h were needed). All data reported refer to dry weight.\"], \"case_id\": \"source-9f8e67169119c4a8\", \"paper\": \"Chemical Characterisation of Spent Rechargeable Batteries\", \"node_id\": \"http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_Iron__Ni_Cd_\"}" ;
    analysis:state "Milled, fractionated and dried to constant mass at 105 °C" ;
    analysis:stream "separated-fractions" .

