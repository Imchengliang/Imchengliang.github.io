<urn:ontoweee:analysis:profile:source-9f8e67169119c4a8%2Ffraction-3> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_1_3_mm__Ni_Cd_" ;
    analysis:case_id "source-9f8e67169119c4a8" ;
    analysis:chemistry "ni-cd" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).",
        "In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-9f8e67169119c4a8/fraction-3" ;
    analysis:label "Ni-Cd fraction 1–3 mm" ;
    analysis:material_class "mixed-electrode-material" ;
    analysis:node_id "http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_1_3_mm__Ni_Cd_" ;
    analysis:note "Table 3 reports leachate release in mg/kg and is excluded from feedstock composition." ;
    analysis:origin "collection-boxes" ;
    analysis:paper "Chemical Characterisation of Spent Rechargeable Batteries" ;
    analysis:payload "{\"id\": \"source-9f8e67169119c4a8/fraction-3\", \"label\": \"Ni-Cd fraction 1–3 mm\", \"chemistry\": \"ni-cd\", \"stream\": \"separated-fractions\", \"origin\": \"collection-boxes\", \"state\": \"Milled, fractionated and dried to constant mass at 105 °C\", \"entity_ids\": [\"Component_1_3_mm__Ni_Cd_\"], \"method_family\": null, \"note\": \"Table 3 reports leachate release in mg/kg and is excluded from feedstock composition.\", \"evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\"], \"material_class\": \"mixed-electrode-material\", \"preparation\": [\"milled\", \"screened\", \"oven-dried\"], \"size_fraction_mm\": [1, 3], \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"Each selected battery type was fed into a continuous milling machine for size reduction, and a fractionation process was then applied, separating the materials in a coarse fraction >3 mm (including the plastic of external shell, residual plastic pieces and felt and cardboard from internal battery protection), and a fine fraction <3 mm (mainly made up of metallic powder deriving from electrodes).\", \"In the laboratory, after a magnetic separation of the coarse ferrous residues contained in Ni–Cd batteries, all samples were divided through a suitable sieve into two further size fractions: U < 1 mm and 1 mm < U < 3 mm. In this way, a possible difference in metal concentration in the various fractions was investigated.\", \"All metals except mercury were measured by ICP/AES; mercury was analysed by cold vapour atomic absorption spectrometry (CVAAS).\", \"Weight loss, mainly due to the vaporisation of moisture and other volatile compounds, was determined by drying the samples to a constant mass at 105 \\u0003C (about 3–4 h were needed). All data reported refer to dry weight.\"], \"case_id\": \"source-9f8e67169119c4a8\", \"paper\": \"Chemical Characterisation of Spent Rechargeable Batteries\", \"node_id\": \"http://weee-kg.org/source:Chemical%20Characterisation%20of%20Spent%20Rechargeable%20Batteries:Component_1_3_mm__Ni_Cd_\"}" ;
    analysis:state "Milled, fractionated and dried to constant mass at 105 °C" ;
    analysis:stream "separated-fractions" .

