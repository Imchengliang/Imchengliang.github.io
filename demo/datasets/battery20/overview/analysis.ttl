<urn:ontoweee:analysis:profile:source-088b0419b6777442%2Ffoil-mixture> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_Al_foil" ;
    analysis:case_id "source-088b0419b6777442" ;
    analysis:chemistry "lco" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "In order to investigate the recovery rate of scrap materials, 200 g LiCoO2 scraps were recovered with the above solvent method. After the recovery, 145.82 g scrap materials (active material, acetylene black) and 41.86 g impure Al foil mixtures (Al foil, active material, acetylene black) were directly obtained through the first separation. Then, after the second step, 21.60 g scrap materials (active material, acetylene black) were collected from 41.86 g impure Al foil mixtures after dissolving Al foil mixtures with excessive NaOH solution. From Fig. 8, there is no Al (OH)3 impurity in 21.60 g scrap materials. So the recovery rate of scrap materials is 145.82/ (145.82 + 21.60) ^* 100 % = 87.10 %, and the purity of Al foil mixtures is (41.86 - 21.60) / 41.86 ^∗100 % = 48.40 %" ;
    analysis:feedstock_history "manufacturing-scrap" ;
    analysis:id "source-088b0419b6777442/foil-mixture" ;
    analysis:label "Impure Al foil mixture after solvent separation" ;
    analysis:material_class "foil-fraction" ;
    analysis:method_family "Alkaline leaching" ;
    analysis:node_id "http://weee-kg.org/source:Heat%20Treatment%20of%20Licoo2%20Recovered%20from%20Cathode%20Scraps%20with%20Solvent%20Method:Component_Al_foil" ;
    analysis:note "This is the downstream foil mixture from solvent separation. NaOH dissolution is linked to that mixture as its experimental input." ;
    analysis:origin "manufacturing-scrap" ;
    analysis:paper "Heat Treatment of Licoo2 Recovered from Cathode Scraps with Solvent Method" ;
    analysis:payload "{\"id\": \"source-088b0419b6777442/foil-mixture\", \"label\": \"Impure Al foil mixture after solvent separation\", \"chemistry\": \"lco\", \"stream\": \"separated-fractions\", \"origin\": \"manufacturing-scrap\", \"state\": \"Al foil with retained active material and acetylene black\", \"entity_ids\": [\"Component_Al_foil\"], \"method_family\": \"Alkaline leaching\", \"note\": \"This is the downstream foil mixture from solvent separation. NaOH dissolution is linked to that mixture as its experimental input.\", \"evidence\": [\"In order to investigate the recovery rate of scrap materials, 200 g LiCoO2 scraps were recovered with the above solvent method. After the recovery, 145.82 g scrap materials (active material, acetylene black) and 41.86 g impure Al foil mixtures (Al foil, active material, acetylene black) were directly obtained through the first separation. Then, after the second step, 21.60 g scrap materials (active material, acetylene black) were collected from 41.86 g impure Al foil mixtures after dissolving Al foil mixtures with excessive NaOH solution. From Fig. 8, there is no Al (OH)3 impurity in 21.60 g scrap materials. So the recovery rate of scrap materials is 145.82/ (145.82 + 21.60) ^* 100 % = 87.10 %, and the purity of Al foil mixtures is (41.86 - 21.60) / 41.86 ^∗100 % = 48.40 %\"], \"material_class\": \"foil-fraction\", \"preparation\": [\"solvent-separated\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"manufacturing-scrap\", \"chemistry_resolved\": true, \"classification_evidence\": [\"In order to investigate the recovery rate of scrap materials, 200 g LiCoO2 scraps were recovered with the above solvent method. After the recovery, 145.82 g scrap materials (active material, acetylene black) and 41.86 g impure Al foil mixtures (Al foil, active material, acetylene black) were directly obtained through the first separation. Then, after the second step, 21.60 g scrap materials (active material, acetylene black) were collected from 41.86 g impure Al foil mixtures after dissolving Al foil mixtures with excessive NaOH solution. From Fig. 8, there is no Al (OH)3 impurity in 21.60 g scrap materials. So the recovery rate of scrap materials is 145.82/ (145.82 + 21.60) ^* 100 % = 87.10 %, and the purity of Al foil mixtures is (41.86 - 21.60) / 41.86 ^∗100 % = 48.40 %\"], \"case_id\": \"source-088b0419b6777442\", \"paper\": \"Heat Treatment of Licoo2 Recovered from Cathode Scraps with Solvent Method\", \"node_id\": \"http://weee-kg.org/source:Heat%20Treatment%20of%20Licoo2%20Recovered%20from%20Cathode%20Scraps%20with%20Solvent%20Method:Component_Al_foil\"}" ;
