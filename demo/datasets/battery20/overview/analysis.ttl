<urn:ontoweee:analysis:profile:source-db98ee012648b4f7%2Fpowder> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_anode",
        "Component_cathode",
        "Product_lithium_ion_battery" ;
    analysis:case_id "source-db98ee012648b4f7" ;
    analysis:chemistry "li-ion-unspecified" ;
    analysis:chemistry_resolved false ;
    analysis:evidenceSpan "The spent LIBs were manually dismantled into different portions including plastic shell, cathode, anode, aluminum foil and so on. Then the separated active cathode and anode containing dense Co and Li were mixed, ground by milling and sieved to obtain a mesh size of less than 200 lm (Mishra et al., 2008a). The resulting powder, used for bioleaching experiments, was digested by HF - HNO _ 3 –HCl method (USEPA, 1996) to determine the content of Co at 358 mg g ^-1 and Li at 45 mg g ^-1 using AAS." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-db98ee012648b4f7/powder" ;
    analysis:label "Mixed cathode and anode powder" ;
    analysis:material_class "mixed-electrode-material" ;
    analysis:method_family "Bioleaching" ;
    analysis:node_id "http://weee-kg.org/source:Process%20Controls%20for%20Improving%20Bioleaching%20Performance%20of%20Both%20Li%20and%20Co%20from%20Spent%20Lithium%20Ion%20Batteries%20at%20High%20Pulp%20Density%20and%20its%20Thermodynamics%20and%20Kineti:Product_lithium_ion_battery" ;
    analysis:note "" ;
    analysis:origin "spent-batteries" ;
    analysis:paper "Process Controls for Improving Bioleaching Performance of Both Li and Co from Spent Lithium Ion Batteries at High Pulp Density and its Thermodynamics and Kineti" ;
    analysis:payload "{\"id\": \"source-db98ee012648b4f7/powder\", \"label\": \"Mixed cathode and anode powder\", \"chemistry\": \"li-ion-unspecified\", \"stream\": \"mixed-electrodes\", \"origin\": \"spent-batteries\", \"state\": \"Mixed, milled and sieved below 200 µm\", \"entity_ids\": [\"Product_lithium_ion_battery\", \"Component_cathode\", \"Component_anode\"], \"method_family\": \"Bioleaching\", \"note\": \"\", \"evidence\": [\"The spent LIBs were manually dismantled into different portions including plastic shell, cathode, anode, aluminum foil and so on. Then the separated active cathode and anode containing dense Co and Li were mixed, ground by milling and sieved to obtain a mesh size of less than 200 lm (Mishra et al., 2008a). The resulting powder, used for bioleaching experiments, was digested by HF - HNO _ 3 –HCl method (USEPA, 1996) to determine the content of Co at 358 mg g ^-1 and Li at 45 mg g ^-1 using AAS.\"], \"material_class\": \"mixed-electrode-material\", \"preparation\": [\"dismantled\", \"milled\", \"screened\"], \"size_fraction_mm\": [null, 0.2], \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": false, \"classification_evidence\": [\"The spent LIBs were manually dismantled into different portions including plastic shell, cathode, anode, aluminum foil and so on. Then the separated active cathode and anode containing dense Co and Li were mixed, ground by milling and sieved to obtain a mesh size of less than 200 lm (Mishra et al., 2008a). The resulting powder, used for bioleaching experiments, was digested by HF - HNO _ 3 –HCl method (USEPA, 1996) to determine the content of Co at 358 mg g ^-1 and Li at 45 mg g ^-1 using AAS.\"], \"case_id\": \"source-db98ee012648b4f7\", \"paper\": \"Process Controls for Improving Bioleaching Performance of Both Li and Co from Spent Lithium Ion Batteries at High Pulp Density and its Thermodynamics and Kineti\", \"node_id\": \"http://weee-kg.org/source:Process%20Controls%20for%20Improving%20Bioleaching%20Performance%20of%20Both%20Li%20and%20Co%20from%20Spent%20Lithium%20Ion%20Batteries%20at%20High%20Pulp%20Density%20and%20its%20Thermodynamics%20and%20Kineti:Product_lithium_ion_battery\"}" ;
    analysis:state "Mixed, milled and sieved below 200 µm" ;
    analysis:stream "mixed-electrodes" .

<urn:ontoweee:analysis:profile:znmn-nicd-bioleaching%2Fzn-mn> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_Zn_Mn_battery" ;
    analysis:case_id "znmn-nicd-bioleaching" ;
    analysis:chemistry "zn-mn" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "The spent Zn–Mn and Ni–Cd batteries were supplied by the Korea Battery Recycling Association (Ansung, Korea). The batteries were manually dismantled. All dismantled materials were collected and safely discarded except for the electrode powder materials. The powder was mixed, dried, ground by milling, and sieved to obtain a mesh size of less than 200 lm (Mishra et al., 2008). To determine the metal content, the powder was dissolved using the USEPA method 3050B (USEPA, 1986). Analysis was done using an inductively coupled plasma-optical emission spectrometer (ICP-OES) (Agilent, USA). The total metal content of Zn–Mn and Ni–Cd batteries is shown in Table 1." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "znmn-nicd-bioleaching/zn-mn" ;
    analysis:label "Zn-Mn mixed electrode powder" ;
    analysis:material_class "mixed-electrode-material" ;
    analysis:method_family "Bioleaching" ;
    analysis:node_id "http://weee-kg.org/source:Bioleaching%20of%20Spent%20Zn%E2%80%93mn%20or%20Ni%E2%80%93cd%20Batteries%20by%20Aspergillus%20Species:Component_Zn_Mn_battery" ;
    analysis:note "Powder compositions are retained separately by battery chemistry. Reported mg/g values are converted to mass percent; no balancing or renormalization." ;
    analysis:origin "spent-batteries" ;
    analysis:paper "Bioleaching of Spent Zn–mn or Ni–cd Batteries by Aspergillus Species" ;
