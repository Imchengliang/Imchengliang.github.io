<urn:ontoweee:analysis:profile:source-e7db048327a675c7%2Fcathode> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_cathode" ;
    analysis:case_id "source-e7db048327a675c7" ;
    analysis:chemistry "lco" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "Cathodic active material from lithium ion secondary battery was separated by a series of thermal treatment, high-speed shredding, calcination steps (Lee and Rhee, 2002). First, LIB samples were thermally treated in a muffle furnace at 150 ^∘C for 1 h. Then, the samples were disassembled with a highspeed shredder. Separated segments were simultaneously classified into the range 1–10 mm in size. Second, thermal treatment was performed in a furnace, and electrode materials were separated from the current collectors by vibrating screening. Next, cathodic active material, LiCoO2 was obtained by burning carbon and binder off in the temperature range 700– 900 ^∘C for 1 h. Fig. 2 shows XRD patterns of calcined cathodic active material at temperature of 700– 900 ^∘C.. The diffractogram indicates that the carbon and binder were burnt off by calcining above 800 ^∘C.. The cathodic active material was ground in a ball mill and dried in an oven at 60 ^∘C for 48 h. The mean particle size was about 15 Am, as shown in Fig. 3 (Lee and Rhee, 2002)." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-e7db048327a675c7/cathode" ;
    analysis:label "Calcined LiCoO2 cathodic active material" ;
    analysis:material_class "cathode-active-material" ;
    analysis:method_family "Acid leaching" ;
    analysis:node_id "http://weee-kg.org/source:Reductive%20Leaching%20of%20Cathodic%20Active%20Materials%20from%20Lithium%20Ion%20Battery%20Wastes:Component_cathode" ;
    analysis:note "Table 1 gives typical whole-battery constituent fractions, including LiCoO2 and Cu/Al mixtures. These are excluded from elemental feedstock mass fractions." ;
    analysis:origin "spent-batteries" ;
    analysis:paper "Reductive Leaching of Cathodic Active Materials from Lithium Ion Battery Wastes" ;
    analysis:payload "{\"id\": \"source-e7db048327a675c7/cathode\", \"label\": \"Calcined LiCoO2 cathodic active material\", \"chemistry\": \"lco\", \"stream\": \"cathode\", \"origin\": \"spent-batteries\", \"state\": \"Thermally separated, calcined and milled\", \"entity_ids\": [\"Component_cathode\"], \"method_family\": \"Acid leaching\", \"note\": \"Table 1 gives typical whole-battery constituent fractions, including LiCoO2 and Cu/Al mixtures. These are excluded from elemental feedstock mass fractions.\", \"evidence\": [\"Cathodic active material from lithium ion secondary battery was separated by a series of thermal treatment, high-speed shredding, calcination steps (Lee and Rhee, 2002). First, LIB samples were thermally treated in a muffle furnace at 150 ^∘C for 1 h. Then, the samples were disassembled with a highspeed shredder. Separated segments were simultaneously classified into the range 1–10 mm in size. Second, thermal treatment was performed in a furnace, and electrode materials were separated from the current collectors by vibrating screening. Next, cathodic active material, LiCoO2 was obtained by burning carbon and binder off in the temperature range 700– 900 ^∘C for 1 h. Fig. 2 shows XRD patterns of calcined cathodic active material at temperature of 700– 900 ^∘C.. The diffractogram indicates that the carbon and binder were burnt off by calcining above 800 ^∘C.. The cathodic active material was ground in a ball mill and dried in an oven at 60 ^∘C for 48 h. The mean particle size was about 15 Am, as shown in Fig. 3 (Lee and Rhee, 2002).\"], \"material_class\": \"cathode-active-material\", \"preparation\": [\"thermally-separated\", \"calcined\", \"milled\", \"dried\"], \"size_fraction_mm\": null, \"thermal_treatment\": {\"temperature_range_c\": [700, 900], \"time_min\": 60}, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"Cathodic active material from lithium ion secondary battery was separated by a series of thermal treatment, high-speed shredding, calcination steps (Lee and Rhee, 2002). First, LIB samples were thermally treated in a muffle furnace at 150 ^∘C for 1 h. Then, the samples were disassembled with a highspeed shredder. Separated segments were simultaneously classified into the range 1–10 mm in size. Second, thermal treatment was performed in a furnace, and electrode materials were separated from the current collectors by vibrating screening. Next, cathodic active material, LiCoO2 was obtained by burning carbon and binder off in the temperature range 700– 900 ^∘C for 1 h. Fig. 2 shows XRD patterns of calcined cathodic active material at temperature of 700– 900 ^∘C.. The diffractogram indicates that the carbon and binder were burnt off by calcining above 800 ^∘C.. The cathodic active material was ground in a ball mill and dried in an oven at 60 ^∘C for 48 h. The mean particle size was about 15 Am, as shown in Fig. 3 (Lee and Rhee, 2002).\"], \"case_id\": \"source-e7db048327a675c7\", \"paper\": \"Reductive Leaching of Cathodic Active Materials from Lithium Ion Battery Wastes\", \"node_id\": \"http://weee-kg.org/source:Reductive%20Leaching%20of%20Cathodic%20Active%20Materials%20from%20Lithium%20Ion%20Battery%20Wastes:Component_cathode\"}" ;
    analysis:state "Thermally separated, calcined and milled" ;
    analysis:stream "cathode" .

