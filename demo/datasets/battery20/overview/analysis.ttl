<urn:ontoweee:analysis:profile:source-bec5c4afbdc9c450%2Fcathode> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_cathode_material",
        "Material_LiCoO" ;
    analysis:case_id "source-bec5c4afbdc9c450" ;
    analysis:chemistry "lco" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "Fig. 2 shows the XRD patterns of spent LiCoO2 cathode material after calcinations and grinding. From XRD data, the crystalline LiCoO2 phase was clearly identified as rock–salt structured [20] and the main compositions of this spent cathode material are LiCoO2 and CoO. In general, the CoO present in the cathode material results from the transformation of LiCoO [29]. Fig. 3 shows SEM/EDX images of the spent LiCoO2 cathode material and the particles were irregularly agglomerated with approximate 5 - 10 μ m diameters. EDXA analysis shows the presence of Co (except Li which cannot be detected by EDXA). SEM/EDX analysis confirms the residual carbon present along with this cathode material due to organic burn off. The source for such carbon might be from the acetylene black used to make sure the electronic conductivity in the cathodes.",
        "The spent LIBs ofBL-5CA (Nokia mobile) series used in this work were collected in the local market. The cathode material was separated from aluminum foil by using concentrated N-methyl pyrrolidone (NMP). The leaching reagents used in this work consisted of glycine and ascorbic acid which were mild organic acids. The reagents used in this study were analytical grade, and all the solutions were prepared with known concentrations in distilled water." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-bec5c4afbdc9c450/cathode" ;
    analysis:label "Separated LiCoO2 cathode material" ;
    analysis:material_class "cathode-active-material" ;
    analysis:method_family "Organic-acid leaching" ;
    analysis:node_id "http://weee-kg.org/source:Recovery%20of%20Cobalt%20as%20Cobalt%20Oxalate%20from%20Spent%20Lithium%20Ion%20Batteries%20by%20Using%20Glycine%20as%20Leaching%20Agent:Component_cathode_material" ;
    analysis:note "Residual carbon and literature review tables are excluded from feedstock metal mass summaries." ;
    analysis:origin "end-of-life-phones" ;
    analysis:paper "Recovery of Cobalt as Cobalt Oxalate from Spent Lithium Ion Batteries by Using Glycine as Leaching Agent" ;
    analysis:payload "{\"id\": \"source-bec5c4afbdc9c450/cathode\", \"label\": \"Separated LiCoO2 cathode material\", \"chemistry\": \"lco\", \"stream\": \"cathode\", \"origin\": \"end-of-life-phones\", \"state\": \"NMP-separated, calcined and ground cathode\", \"entity_ids\": [\"Component_cathode_material\", \"Material_LiCoO\"], \"method_family\": \"Organic-acid leaching\", \"note\": \"Residual carbon and literature review tables are excluded from feedstock metal mass summaries.\", \"evidence\": [\"The spent LIBs ofBL-5CA (Nokia mobile) series used in this work were collected in the local market. The cathode material was separated from aluminum foil by using concentrated N-methyl pyrrolidone (NMP). The leaching reagents used in this work consisted of glycine and ascorbic acid which were mild organic acids. The reagents used in this study were analytical grade, and all the solutions were prepared with known concentrations in distilled water.\", \"Fig. 2 shows the XRD patterns of spent LiCoO2 cathode material after calcinations and grinding. From XRD data, the crystalline LiCoO2 phase was clearly identified as rock–salt structured [20] and the main compositions of this spent cathode material are LiCoO2 and CoO. In general, the CoO present in the cathode material results from the transformation of LiCoO [29]. Fig. 3 shows SEM/EDX images of the spent LiCoO2 cathode material and the particles were irregularly agglomerated with approximate 5 - 10 μ m diameters. EDXA analysis shows the presence of Co (except Li which cannot be detected by EDXA). SEM/EDX analysis confirms the residual carbon present along with this cathode material due to organic burn off. The source for such carbon might be from the acetylene black used to make sure the electronic conductivity in the cathodes.\"], \"material_class\": \"cathode-active-material\", \"preparation\": [\"solvent-separated\", \"calcined\", \"milled\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"The spent LIBs ofBL-5CA (Nokia mobile) series used in this work were collected in the local market. The cathode material was separated from aluminum foil by using concentrated N-methyl pyrrolidone (NMP). The leaching reagents used in this work consisted of glycine and ascorbic acid which were mild organic acids. The reagents used in this study were analytical grade, and all the solutions were prepared with known concentrations in distilled water.\", \"Fig. 2 shows the XRD patterns of spent LiCoO2 cathode material after calcinations and grinding. From XRD data, the crystalline LiCoO2 phase was clearly identified as rock–salt structured [20] and the main compositions of this spent cathode material are LiCoO2 and CoO. In general, the CoO present in the cathode material results from the transformation of LiCoO [29]. Fig. 3 shows SEM/EDX images of the spent LiCoO2 cathode material and the particles were irregularly agglomerated with approximate 5 - 10 μ m diameters. EDXA analysis shows the presence of Co (except Li which cannot be detected by EDXA). SEM/EDX analysis confirms the residual carbon present along with this cathode material due to organic burn off. The source for such carbon might be from the acetylene black used to make sure the electronic conductivity in the cathodes.\"], \"case_id\": \"source-bec5c4afbdc9c450\", \"paper\": \"Recovery of Cobalt as Cobalt Oxalate from Spent Lithium Ion Batteries by Using Glycine as Leaching Agent\", \"node_id\": \"http://weee-kg.org/source:Recovery%20of%20Cobalt%20as%20Cobalt%20Oxalate%20from%20Spent%20Lithium%20Ion%20Batteries%20by%20Using%20Glycine%20as%20Leaching%20Agent:Component_cathode_material\"}" ;
    analysis:state "NMP-separated, calcined and ground cathode" ;
    analysis:stream "cathode" .

