<urn:ontoweee:analysis:profile:nimh-recovery%2Fpositive> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_positive_electrode" ;
    analysis:case_id "nimh-recovery" ;
    analysis:chemistry "ni-mh" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "The Ni-MH batteries used in this work were cylinder-shaped batteries TOSHIBAŽ TH-3A type. The commercial extractants employed, bis 2-ethylhexyl phosphoric acid. Ž. Ž. Ž. D2EHPA was kindly donated by Daihachi Chemical Industry and trioctylamine TOA was purchased from Aldrich Chemical Company Inc. These reagents were utilized without any further purification. The concentrations of the extractants in the organic solution were 25% by volume. The diluent was kerosene. 1-Dodecanol was used as third phase inhibitor in the TOA system, and its concentration was 15 vol.%. The organic solution of TOA was pre-equilibrated by contacting with twice volume of 2 M hydrochloric acid solution for 10 min before the extraction experiments. Other reagents were of analytical reagent grade quality." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "nimh-recovery/positive" ;
    analysis:label "Ni-MH positive electrode" ;
    analysis:material_class "positive-electrode" ;
    analysis:node_id "http://weee-kg.org/source:Hydrometallurgical%20Process%20for%20Recovery%20of%20Metal%20Values%20from%20Spent%20Nickel-Metal%20Hydride%20Secondary%20Batteries:Component_positive_electrode" ;
    analysis:note "Original table reports electrode chemical components in wt.%; oxygen and unreported constituents are not reconstructed. Do not treat these as whole-cell composition." ;
    analysis:origin "spent-batteries" ;
    analysis:paper "Hydrometallurgical Process for Recovery of Metal Values from Spent Nickel-Metal Hydride Secondary Batteries" ;
    analysis:payload "{\"id\": \"nimh-recovery/positive\", \"label\": \"Ni-MH positive electrode\", \"chemistry\": \"ni-mh\", \"stream\": \"cathode\", \"origin\": \"spent-batteries\", \"state\": \"Separated electrode; reported chemical components\", \"entity_ids\": [\"Component_positive_electrode\"], \"method_family\": null, \"note\": \"Original table reports electrode chemical components in wt.%; oxygen and unreported constituents are not reconstructed. Do not treat these as whole-cell composition.\", \"evidence\": [\"The Ni-MH batteries used in this work were cylinder-shaped batteries TOSHIBAŽ TH-3A type. The commercial extractants employed, bis 2-ethylhexyl phosphoric acid. Ž. Ž. Ž. D2EHPA was kindly donated by Daihachi Chemical Industry and trioctylamine TOA was purchased from Aldrich Chemical Company Inc. These reagents were utilized without any further purification. The concentrations of the extractants in the organic solution were 25% by volume. The diluent was kerosene. 1-Dodecanol was used as third phase inhibitor in the TOA system, and its concentration was 15 vol.%. The organic solution of TOA was pre-equilibrated by contacting with twice volume of 2 M hydrochloric acid solution for 10 min before the extraction experiments. Other reagents were of analytical reagent grade quality.\"], \"material_class\": \"positive-electrode\", \"preparation\": [\"dismantled\", \"separated\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"The Ni-MH batteries used in this work were cylinder-shaped batteries TOSHIBAŽ TH-3A type. The commercial extractants employed, bis 2-ethylhexyl phosphoric acid. Ž. Ž. Ž. D2EHPA was kindly donated by Daihachi Chemical Industry and trioctylamine TOA was purchased from Aldrich Chemical Company Inc. These reagents were utilized without any further purification. The concentrations of the extractants in the organic solution were 25% by volume. The diluent was kerosene. 1-Dodecanol was used as third phase inhibitor in the TOA system, and its concentration was 15 vol.%. The organic solution of TOA was pre-equilibrated by contacting with twice volume of 2 M hydrochloric acid solution for 10 min before the extraction experiments. Other reagents were of analytical reagent grade quality.\", \"The nickel-metal hydride batteries were cut in half longitudinally to separate the metallic cases from the internal battery rolls which consisted of the positive and negative electrodes plus a nylon separator. The cells weighed an average of 24.8 g each and contained an AB5 - t y p e rare earth metal system negative electrode. The weight of theŽ. positive electrode in one cell was 7.27 g and that of the negative electrode was 10.57 g in which the alloy powder accounted for 87.6% and the metal-mesh 12.4%. The components of the active material on the positive electrode, the alloy powder and the metal-mesh on the negative electrode were determined separately by total dissolution with aqua regia.\"], \"case_id\": \"nimh-recovery\", \"paper\": \"Hydrometallurgical Process for Recovery of Metal Values from Spent Nickel-Metal Hydride Secondary Batteries\", \"node_id\": \"http://weee-kg.org/source:Hydrometallurgical%20Process%20for%20Recovery%20of%20Metal%20Values%20from%20Spent%20Nickel-Metal%20Hydride%20Secondary%20Batteries:Component_positive_electrode\"}" ;
    analysis:state "Separated electrode; reported chemical components" ;
    analysis:stream "cathode" .

