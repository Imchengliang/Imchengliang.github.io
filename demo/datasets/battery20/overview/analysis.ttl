<urn:ontoweee:analysis:profile:source-98d7e11c7ecce524%2Fwhole> a analysis:SampleProfile ;
    analysis:archiveEntityId "Component_lithium_ion_battery" ;
    analysis:case_id "source-98d7e11c7ecce524" ;
    analysis:chemistry "lco" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "The spent LIBs used in this study were provided by TES-AMM Co. Ltd. LiCoO and carbon powders were fixed on Al and Cu foils as positive and negative electrodes, respectively. The components of LIBs were separated and measured in the laboratory as follows. First, the crust was removed with pincers and saws. Then, all of the parts were put into hydrochloric acid, heated and agitated at 90 -C for 4 h, dissolving all of the metals. The concentrations of different metals were measured with an inductive coupled plasma atomic emission spectrometer (ICP-AES). Finally, the content of each metal in the battery was calculated. The results indicated that Co accounted for 16% and Li, Cu, Al, Fe accounted for 2%, 10%, 3%, and 19% of the mass, respectively." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-98d7e11c7ecce524/whole" ;
    analysis:label "Whole spent lithium-ion batteries" ;
    analysis:material_class "whole-cell" ;
    analysis:node_id "http://weee-kg.org/source:A%20Combined%20Recovery%20Process%20of%20Metals%20in%20Spent%20Lithium-Ion%20Batteries:Component_lithium_ion_battery" ;
    analysis:note "" ;
    analysis:origin "recycling-company" ;
    analysis:paper "A Combined Recovery Process of Metals in Spent Lithium-Ion Batteries" ;
