<urn:ontoweee:analysis:profile:source-b54b7c6d06066264%2Ffragments> a analysis:SampleProfile ;
    analysis:archiveEntityId "Product_crushed_product",
        "Product_lithium_iron_phosphate_battery" ;
    analysis:case_id "source-b54b7c6d06066264" ;
    analysis:chemistry "lfp" ;
    analysis:chemistry_resolved true ;
    analysis:evidenceSpan "The power battery consists of positive electrode, negative electrode, electrolyte, separator and sealed shell. The cathode materials such as lithium manganate, lithium cobalt acid, lithium iron phosphate and three-element system are bonded together to the aluminum foil using binder PVDF, and the negative electrode is formed by bonding a negative electrode material such as carbonbased, tin-based or silicon-based material, or lithium titanate to the copper foil. The electrolyte is mostly made of LiFL6 and organic solvent. The membrane material is mainly polyethylene (PE) or polypropylene (PP) and is used to prevent the electrons passing through the anode and cathode, allowing lithium ions to pass through. The sealed shell protects core and carries electrolyte, and is made of plastic, steel or aluminum alloy. Presently, most power lithium batteries have aluminum shells. The sample used here is a lithium iron phosphate power battery crushed using the production line in HeFei GuoXuan High-Tech Power Energy CO. Ltd. The crushed products of the core breakage are shown in Figure 1. The physical properties are listed in Table 1. The recycling system based on pneumatic separation is presented in Figure 2, and a flow chart of the recycling process is illustrated in Figure 3." ;
    analysis:feedstock_history "end-of-life" ;
    analysis:id "source-b54b7c6d06066264/fragments" ;
    analysis:label "Crushed LiFePO4 battery-core fragments" ;
    analysis:material_class "cell-core-fragments" ;
    analysis:method_family "Physical separation" ;
    analysis:node_id "http://weee-kg.org/source:Pneumatic%20Separation%20and%20Recycling%20of%20Anode%20and%20Cathode%20Materials%20from%20Spent%20Lithium%20Iron%20Phosphate%20Batteries:Product_crushed_product" ;
    analysis:note "Al=96% and Cu=97% are product metal fractions. Component masses in kg have no validated whole-sample mass denominator." ;
    analysis:origin "power-battery" ;
    analysis:paper "Pneumatic Separation and Recycling of Anode and Cathode Materials from Spent Lithium Iron Phosphate Batteries" ;
    analysis:payload "{\"id\": \"source-b54b7c6d06066264/fragments\", \"label\": \"Crushed LiFePO4 battery-core fragments\", \"chemistry\": \"lfp\", \"stream\": \"mixed-electrodes\", \"origin\": \"power-battery\", \"state\": \"Crushed cell-core fragments\", \"entity_ids\": [\"Product_crushed_product\", \"Product_lithium_iron_phosphate_battery\"], \"method_family\": \"Physical separation\", \"note\": \"Al=96% and Cu=97% are product metal fractions. Component masses in kg have no validated whole-sample mass denominator.\", \"evidence\": [\"The power battery consists of positive electrode, negative electrode, electrolyte, separator and sealed shell. The cathode materials such as lithium manganate, lithium cobalt acid, lithium iron phosphate and three-element system are bonded together to the aluminum foil using binder PVDF, and the negative electrode is formed by bonding a negative electrode material such as carbonbased, tin-based or silicon-based material, or lithium titanate to the copper foil. The electrolyte is mostly made of LiFL6 and organic solvent. The membrane material is mainly polyethylene (PE) or polypropylene (PP) and is used to prevent the electrons passing through the anode and cathode, allowing lithium ions to pass through. The sealed shell protects core and carries electrolyte, and is made of plastic, steel or aluminum alloy. Presently, most power lithium batteries have aluminum shells. The sample used here is a lithium iron phosphate power battery crushed using the production line in HeFei GuoXuan High-Tech Power Energy CO. Ltd. The crushed products of the core breakage are shown in Figure 1. The physical properties are listed in Table 1. The recycling system based on pneumatic separation is presented in Figure 2, and a flow chart of the recycling process is illustrated in Figure 3.\"], \"material_class\": \"cell-core-fragments\", \"preparation\": [\"dismantled\", \"crushed\"], \"size_fraction_mm\": null, \"thermal_treatment\": null, \"feedstock_history\": \"end-of-life\", \"chemistry_resolved\": true, \"classification_evidence\": [\"The power battery consists of positive electrode, negative electrode, electrolyte, separator and sealed shell. The cathode materials such as lithium manganate, lithium cobalt acid, lithium iron phosphate and three-element system are bonded together to the aluminum foil using binder PVDF, and the negative electrode is formed by bonding a negative electrode material such as carbonbased, tin-based or silicon-based material, or lithium titanate to the copper foil. The electrolyte is mostly made of LiFL6 and organic solvent. The membrane material is mainly polyethylene (PE) or polypropylene (PP) and is used to prevent the electrons passing through the anode and cathode, allowing lithium ions to pass through. The sealed shell protects core and carries electrolyte, and is made of plastic, steel or aluminum alloy. Presently, most power lithium batteries have aluminum shells. The sample used here is a lithium iron phosphate power battery crushed using the production line in HeFei GuoXuan High-Tech Power Energy CO. Ltd. The crushed products of the core breakage are shown in Figure 1. The physical properties are listed in Table 1. The recycling system based on pneumatic separation is presented in Figure 2, and a flow chart of the recycling process is illustrated in Figure 3.\"], \"case_id\": \"source-b54b7c6d06066264\", \"paper\": \"Pneumatic Separation and Recycling of Anode and Cathode Materials from Spent Lithium Iron Phosphate Batteries\", \"node_id\": \"http://weee-kg.org/source:Pneumatic%20Separation%20and%20Recycling%20of%20Anode%20and%20Cathode%20Materials%20from%20Spent%20Lithium%20Iron%20Phosphate%20Batteries:Product_crushed_product\"}" ;
    analysis:state "Crushed cell-core fragments" ;
    analysis:stream "mixed-electrodes" .

